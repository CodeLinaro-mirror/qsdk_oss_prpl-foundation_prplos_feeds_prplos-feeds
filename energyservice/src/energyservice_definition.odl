%define {
object EnergyService {
    %persistent bool StartService = false {
        on action write call energyservice_start_service;
    }

    object Config {
        %persistent string DbgLevels = "all=1" { on action write call energyservice_sync; }
        %persistent bool Respawn = true { on action write call energyservice_sync; }
        %persistent uint32 WlanIfacesNotUpWait = 10 { on action write call energyservice_sync; }
        %persistent bool LogToFile = true { on action write call energyservice_sync; }
        %persistent uint32 LogFileSize = 5000 { on action write call energyservice_sync; }
    }

    object Wlanif {
        %persistent uint32 AppInitSendDelay = 1 { on action write call energyservice_sync; }
        %persistent uint32 AppInitRetryTimeout = 5 { on action write call energyservice_sync; }
        %persistent uint32 AppInitMaxRetries = 60 { on action write call energyservice_sync; }
        %persistent string NetlinkVdevInterfacePrefix = "ath" { on action write call energyservice_sync; }
        %persistent string NetlinkPdevInterfacePrefix = "wifi" { on action write call energyservice_sync; }
        %persistent string NetlinkInterfacePrefixCompareLength = "3" { on action write call energyservice_sync; }
    }

    object Energy {
        %persistent bool Enable = false { on action write call energyservice_sync; }
        %persistent string DbgLevels = "all=1" { on action write call energyservice_sync; }
        %persistent uint32 EnergyServiceMonitoringTimeout = 1 { on action write call energyservice_sync; }
        %persistent uint32 EnergyServiceCoolingPeriodToReduceBWorChain = 600 { on action write call energyservice_sync; }
        %persistent uint32 EnergyServiceMinimumAvailableAirtimeToReduceBWorChain = 20 { on action write call energyservice_sync; }
        %persistent uint32 EnergyServiceTriggerAirtimeUtilThreshold = 5 { on action write call energyservice_sync; }
        %persistent uint32 EnergyServiceTriggerResourceExpansionAirtimeUtilThreshold = 10 { on action write call energyservice_sync; }
        %persistent uint32 EnergyServiceMinimumBwToChange = 0 { on action write call energyservice_sync; }
        %persistent uint32 EnergyServiceMinimumTxChainToChange = 0 { on action write call energyservice_sync; }
        %persistent uint32 EnergyServiceMinimumRxChainToChange = 0 { on action write call energyservice_sync; }
        %persistent uint32 EnergyServiceMinimumRequestedBwToChange = 20 { on action write call energyservice_sync; }
        %persistent uint32 EnergyServiceMinimumRequestedTxChainToChange = 5 { on action write call energyservice_sync; }
        %persistent uint32 EnergyServiceMinimumRequestedRxChainToChange = 5 { on action write call energyservice_sync; }
        %persistent uint32 EnergyServiceMinimumClientPhymode = 0 { on action write call energyservice_sync; }
        %persistent bool EnergyServiceUseOnlyRequestedConfig = false { on action write call energyservice_sync; }
        %persistent bool EnergyServiceLCEnable = false { on action write call energyservice_sync; }
        %persistent uint32 EnergyServiceLCLinkBringUpAAThresh = 25 { on action write call energyservice_sync; }
        %persistent uint32 EnergyServiceLCLinkBringDownAAThresh = 75 { on action write call energyservice_sync; }
        %persistent uint32 EnergyServiceLCLinkBringDownPeerNumThresh = 5 { on action write call energyservice_sync; }
        %persistent uint32 EnergyServiceLCType = 1 { on action write call energyservice_sync; }
        %persistent string EnergyServiceLCAlwaysUpBand = "BAND_2GHZ" { on action write call energyservice_sync; }
        %persistent uint32 EnergyServiceLCMonitoringTimeout = 300 { on action write call energyservice_sync; }
        %persistent uint32 EnergyServiceAlgoMode = 2 { on action write call energyservice_sync; }
        %persistent uint32 EnergyServicePredominantMcsThreshold = 90 { on action write call energyservice_sync; }
        %persistent uint32 EnergyServicePredominantBwThreshold = 80 { on action write call energyservice_sync; }
        %persistent uint32 EnergyServiceMaxThroughputThreshold20Mhz = 10 { on action write call energyservice_sync; }
        %persistent uint32 EnergyServiceMaxThroughputThreshold40Mhz = 30 { on action write call energyservice_sync; }
        %persistent uint32 EnergyServiceMaxThroughputThreshold80Mhz = 80 { on action write call energyservice_sync; }
        %persistent uint32 EnergyServiceMinMcsForTxReduction = 5 { on action write call energyservice_sync; }
        %persistent bool EnergyServiceLicenseEnabled = false { on action write call energyservice_sync; }
    }

    object Erp {
        %persistent string DbgLevels = "all=3" { on action write call energyservice_sync; }
        %persistent uint32 IdlePollPeriod = 60 { on action write call energyservice_sync; }
        %persistent uint32 erp_mode = 2 { on action write call energyservice_sync; }
        %persistent uint32 pon_mode = 0 { on action write call energyservice_sync; }
        %persistent bool is_nss_standby_disabled = false { on action write call energyservice_sync; }
        %persistent bool is_pon_standby_disabled = false { on action write call energyservice_sync; }
        %persistent bool is_wifi_standby_disabled = false { on action write call energyservice_sync; }
        %persistent bool is_bsp_standby_disabled = false { on action write call energyservice_sync; }
        %persistent bool is_green_ap_disabled = false { on action write call energyservice_sync; }
    }

    /* ERP command/status DMs are intentionally not written to gw_energy_app.conf. */
    /* The complete command must start with "erp cli enter" or "erp cli exit". */
    %volatile string ERPServiceEnter = "" { on action write call energyservice_erp_enter; }
    %volatile string ERPServiceExit = "" { on action write call energyservice_erp_exit; }
    %persistent uint32 EcoModeEnter = 0 { on action write call energyservice_sync; }
    %persistent uint32 EcoModeExit = 0 { on action write call energyservice_sync; }

    /* Runtime ERP status returned by the Energy App CLI. */
    object ERPService {
        /* Query the ERP CLI and return the current status table. */
        string StatusRefresh() <!import:${name}:_energyservice_status_refresh!>;
    }
}
}
