. /usr/lib/amx/scripts/amx_procd_init_functions.sh

START=42
STOP=42
USE_PROCD=1

name="energyservice"
PROG="/usr/bin/amxrt"
datamodel_root="EnergyService"
PROG_OPTIONS="/etc/amx/${name}/${name}.odl"

start_service() {
	register_service ${name} ${PROG} ${PROG_OPTIONS}
}

stop_service() {
	deregister_service ${name}
}
