config config 'config'
	option DbgLevels 'all=1'
	option Respawn '1'
	option WlanIfacesNotUpWait '10'
	option LogToFile '1'
	option LogFileSize '5000'

config energy 'energy'
	option Enable '0'
	option DbgLevels 'all=1'
	option EnergyServiceMonitoringTimeout '1'
	option EnergyServiceCoolingPeriodToReduceBWorChain '600'
	option EnergyServiceMinimumAvailableAirtimeToReduceBWorChain '20'
	option EnergyServiceTriggerAirtimeUtilThreshold '5'
	option EnergyServiceTriggerResourceExpansionAirtimeUtilThreshold '10'
	option EnergyServiceMinimumBwToChange '0'
	option EnergyServiceMinimumTxChainToChange '0'
	option EnergyServiceMinimumRxChainToChange '0'
	option EnergyServiceMinimumRequestedBwToChange '20'
	option EnergyServiceMinimumRequestedTxChainToChange '5'
	option EnergyServiceMinimumRequestedRxChainToChange '5'
	option EnergyServiceMinimumClientPhymode '0'
	option EnergyServiceUseOnlyRequestedConfig '0'
	option EnergyServiceLCEnable '0'
	option EnergyServiceLCLinkBringUpAAThresh '25'
	option EnergyServiceLCLinkBringDownAAThresh '75'
	option EnergyServiceLCLinkBringDownPeerNumThresh '5'
	option EnergyServiceLCType '1'
	option EnergyServiceLCAlwaysUpBand 'BAND_2GHZ'
	option EnergyServiceLCMonitoringTimeout '300'
	option EnergyServiceAlgoMode '0'
	option EnergyServicePredominantMcsThreshold '0'
	option EnergyServicePredominantBwThreshold '0'
	option EnergyServiceMaxThroughputThreshold20Mhz '0'
	option EnergyServiceMaxThroughputThreshold40Mhz '0'
	option EnergyServiceMaxThroughputThreshold80Mhz '0'
	option EnergyServiceMinMcsForTxReduction '0'
	option EnergyServiceLicenseEnabled '0'

config wlanif 'wlanif'
	option AppInitSendDelay '1'
	option AppInitRetryTimeout '5'
	option AppInitMaxRetries '60'
	option NetlinkVdevInterfacePrefix 'ath'
	option NetlinkPdevInterfacePrefix 'wifi'
	option NetlinkInterfacePrefixCompareLength '3'

config erpservice 'erp_service'
	option DbgLevels 'all=1'
	option IdlePollPeriod '60'
	option erp_mode '2'
	option pon_mode '0'
	option is_nss_standby_disabled '0'
	option is_pon_standby_disabled '0'
	option is_wifi_standby_disabled '0'
	option is_bsp_standby_disabled '0'
	option is_green_ap_disabled '0'
