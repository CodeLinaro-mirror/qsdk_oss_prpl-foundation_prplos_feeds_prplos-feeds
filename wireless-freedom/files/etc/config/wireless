
config vendor 'vendor'
        option min_phy '3'
        option phy_detect_timeout '10'

config smp_affinity 'mac80211'
        option enable_smp_affinity '1'
        option enable_color '1'

config wifi-device 'radio0_band0'
        option type 'mac80211'
        option path 'soc/1bf0000.qcom,pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
        option band '2g'
        option channel '6'
        option radio '2'
        option channels '1-11'
        option htmode 'EHT20'
        option disabled '1'

config wifi-iface 'default_radio0_band0'
        option device 'radio0_band0'
        option network 'lan'
        option mode 'ap'
        option ssid 'prplOS'
        option encryption 'none'

config wifi-device 'radio0_band1'
        option type 'mac80211'
        option path 'soc/1bf0000.qcom,pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
        option band '5g'
        option channel '36'
        option radio '0'
        option channels '36-165'
        option htmode 'EHT80'
        option disabled '1'

config wifi-iface 'default_radio0_band1'
        option device 'radio0_band1'
        option network 'lan'
        option mode 'ap'
        option ssid 'prplOS'
        option encryption 'none'

config wifi-device 'radio0_band2'
        option type 'mac80211'
        option path 'soc/1bf0000.qcom,pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
        option band '6g'
        option channel '49'
        option radio '1'
        option channels '1-233'
        option htmode 'EHT80'
        option disabled '1'

config wifi-iface 'default_radio0_band2'
        option device 'radio0_band2'
        option network 'lan'
        option mode 'ap'
        option ssid 'prplOS'
        option encryption 'sae'
        option sae_pwe '1'
        option key '0123456789'

